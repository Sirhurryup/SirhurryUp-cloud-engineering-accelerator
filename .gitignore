.DS_Store
__pycache__/

# Terraform local provider files
**/.terraform/*

# Terraform state files and backups
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Local Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Downloaded AWS Session Manager installer
session-manager-plugin.pkg

# Saved Terraform execution plans
*.tfplan